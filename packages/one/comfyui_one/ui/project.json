{
	"$schema": "node_modules/nx/schemas/project-schema.json",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vite build",
				"cwd": "{projectRoot}"
			}
		},
		"build:inspect": {
			"cache": false,
			"executor": "nx:run-commands",
			"options": {
				"command": "vite build",
				"cwd": "{projectRoot}"
			}
		}
	}
}
